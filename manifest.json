{
  "manifest_version": 3,
  "name": "Project Time Tracker",
  "version": "1.0.0",
  "description": "Track time against your projects directly from Chrome.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
